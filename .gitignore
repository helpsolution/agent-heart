# --- Приватные данные ------------------------------------------------------
# Сгенерированный дашборд содержит названия сессий (то есть формулировки
# рабочих задач), полные пути к проектам и суммы расхода. Публиковать нельзя.
dashboard.html
*.html
!docs/**/*.html

# Отчёты по задачам: реальные цифры расхода и названия проектов.
swarm-report/

# Снимки интерфейса могут содержать реальные данные — только осознанно.
screenshots/
*.png
!docs/**/*.png

